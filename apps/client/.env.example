# RE:Arena client environment
#
# Copy to .env.local and fill in. Everything here is PUBLIC: Vite inlines VITE_* variables into the
# bundle, so anyone can read them. That is fine for these four and must never be true of a service
# role key, which belongs only in Edge Function secrets.
#
# .env.local is gitignored. .env.example is committed and holds no real values.

# Supabase project URL.
# Local:      http://127.0.0.1:54321   (printed by `supabase status`)
# Production: https://nprfxnegcwqqpjasoxln.supabase.co
VITE_SUPABASE_URL=https://nprfxnegcwqqpjasoxln.supabase.co

# Anonymous key. Safe to ship: every table is behind row-level security, so this key can only reach
# what the RLS policies allow for the signed-in user.
# Local:      printed by `supabase status` as "anon key"
# Production: Supabase dashboard > Project Settings > API > anon public
VITE_SUPABASE_ANON_KEY=sb_publishable_7aL0Wq-Xf1cnSfNHoBXfqQ_MwTtjoDx

# Base URL for content bundles on the rearena-content static host.
# Leave blank for local development: the client falls back to the built-in greybox arena.
VITE_CONTENT_BASE_URL=

# Build identifier, shown in settings and attached to submitted runs so a rejected run can be traced
# to the build that produced it. CI sets this to the commit SHA.
VITE_BUILD_ID=local
