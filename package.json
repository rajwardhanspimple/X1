{
  "name": "rearena",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './apps/*' --filter './packages/*' run build",
    "dev": "pnpm --filter @rearena/client dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sim": "pnpm --filter @rearena/sim test",
    "test:e2e": "pnpm --filter @rearena/e2e test",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:check": "node tools/check-env.mjs",
    "content:check": "pnpm --filter @rearena/asset-pipeline check",
    "content:build": "pnpm --filter @rearena/asset-pipeline build",
    "content:manifest": "pnpm --filter @rearena/asset-pipeline manifest",
    "content:publish": "pnpm --filter @rearena/asset-pipeline publish",
    "functions:build": "pnpm --filter @rearena/protocol --filter @rearena/content-schema --filter @rearena/sim run build",
    "functions:deploy": "pnpm functions:build && supabase functions deploy verify-run"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.11.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0",
    "vitest": "^2.1.3"
  }
}
